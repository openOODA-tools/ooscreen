# Maintainer: openOODA-tools <ops@openooda.org>
pkgname=ooscreen-bin
_pkgname=ooscreen
pkgver=0.1.0
pkgrel=1
pkgdesc="Lightweight background screen detacher with socket reconnect and credential isolation."
arch=('x86_64')
url="https://github.com/openOODA-tools/ooscreen"
license=('Apache-2.0')
depends=('glibc')
provides=('ooscreen')
conflicts=('ooscreen')
source_x86_64=("${url}/releases/download/v${pkgver}/ooscreen-linux-x86_64"
               "uninstall.sh::https://raw.githubusercontent.com/openOODA-tools/${_pkgname}/v${pkgver}/uninstall.sh")
sha256sums_x86_64=('SKIP'
                   'SKIP')

package() {
    install -Dm755 "${srcdir}/ooscreen-linux-x86_64" "${pkgdir}/usr/bin/ooscreen"
    install -Dm755 uninstall.sh "${pkgdir}/usr/bin/ooscreen-uninstall"
}
